# Local development needs nothing here: the app uses data/myboakeno.db (SQLite file).
#
# Production (Vercel) has a read-only filesystem, so it must use a hosted libSQL/Turso
# database. Create a free database at https://turso.tech, then copy its URL and token
# into the Vercel project's environment variables (Settings -> Environment Variables).
TURSO_DATABASE_URL=
TURSO_AUTH_TOKEN=

# Optional: the only email that gets the administrator role.
# Leave empty to use the address configured in lib/auth.ts.
ADMIN_EMAIL=
